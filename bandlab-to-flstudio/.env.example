# Paste ONE of these after logging in to bandlab.com in your browser. Never your password.
# Chrome/Edge: F12 -> Application -> Cookies -> https://www.bandlab.com -> refreshToken (value)
BANDLAB_REFRESH_TOKEN=
# or: F12 -> Network -> any request to api/v1.3 -> Request Headers -> Authorization (whole value)
BANDLAB_SESSION_KEY=
